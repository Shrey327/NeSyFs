# Copy to .env and replace the empty values. Never commit .env.
# The full agent makes paid API calls. The scripted walkthrough does not.
OPENAI_API_KEY=
NESYFS_MODEL=gpt-4.1-mini

# Local Neo4j. Choose a password of at least eight characters before starting.
# The bundled Compose service uses the fixed initial username neo4j.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# All limits must be positive integers.
NESYFS_REFLECTION_LIMIT=3
NESYFS_REFLECTION_SAMPLES=5
NESYFS_PARTICLE_COUNT=6
NESYFS_PLANNING_HORIZON=5
NESYFS_RETRIEVAL_LIMIT=100
